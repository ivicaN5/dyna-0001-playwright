{
  "name": "dyna-0001-playwright",
  "version": "1.0.0",
  "description": "Playwright repository for testing Dynapps web project",
  "main": "index.js",
  "scripts": {
    "dev:run:e2e": "npx playwright test tests/e2e",
    "dev:open:e2e": "npx playwright test tests/e2e --ui",
    "dev:run:features": "npx playwright test tests/features",
    "dev:open:features": "npx playwright test tests/features --ui",
    "dev:run:visual": "npx playwright test tests/visual",
    "dev:open:visual": "npx playwright test tests/visual --ui",
    "dev:update:visual": "npx playwright test tests/visual --update-snapshots",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivicaN5/dyna-0001-playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ivicaN5/dyna-0001-playwright/issues"
  },
  "homepage": "https://github.com/ivicaN5/dyna-0001-playwright#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
